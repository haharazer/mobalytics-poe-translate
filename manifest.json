{
  "manifest_version": 3,
  "name": "Mobalytics PoE 中文化",
  "version": "0.1.0",
  "version_name": "0.1.0 初版",
  "description": "将 Mobalytics 的 Path of Exile 1 攻略页技能石名称翻译为简体或繁体中文。",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_title": "Mobalytics PoE 中文化",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://mobalytics.gg/poe/builds/*",
        "https://www.mobalytics.gg/poe/builds/*"
      ],
      "js": [
        "src/translation-core.js",
        "data/poe1-skill-gems.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
